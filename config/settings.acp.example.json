{
  "ai_approval": {
    "enabled": false,
    "base_url": "https://api.openai.com/v1",
    "api_key": "",
    "model": "gpt-4.1-mini",
    "max_risk": "low"
  },
  "model_providers": [],
  "acp_servers": [
    {
      "id": "kiro-local",
      "name": "Kiro Local ACP",
      "profile": "stdio",
      "command": "kiro-cli",
      "args": ["acp"],
      "auth_token": "",
      "default_model": "claude-sonnet-4",
      "enabled": true,
      "priority": 0,
      "headers": [],
      "env": [
        {"key": "KIRO_API_KEY", "value": ""},
        {"key": "XDG_RUNTIME_DIR", "value": "/run/user/1000"},
        {"key": "DBUS_SESSION_BUS_ADDRESS", "value": "unix:path=/run/user/1000/bus"}
      ]
    },
    {
      "id": "opencode-acp",
      "name": "OpenCode ACP",
      "profile": "stdio",
      "command": "opencode",
      "args": ["acp"],
      "auth_token": "",
      "default_model": "",
      "enabled": false,
      "priority": 20,
      "headers": [],
      "env": []
    },
    {
      "id": "codex-acp",
      "name": "Codex ACP",
      "profile": "stdio",
      "command": "codex",
      "args": ["acp"],
      "auth_token": "",
      "default_model": "",
      "enabled": false,
      "priority": 30,
      "headers": [],
      "env": []
    },
    {
      "id": "acp-http",
      "name": "ACP HTTP Gateway",
      "profile": "generic_http",
      "endpoint": "https://acp.example.com",
      "auth_token": "replace-me",
      "default_model": "acp-default-model",
      "enabled": false,
      "priority": 10,
      "headers": [
        {
          "key": "X-ACP-Client",
          "value": "omni-code-bridge"
        }
      ],
      "env": []
    }
  ]
}

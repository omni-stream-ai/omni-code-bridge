  "runtime": {
    "provider": "docker",
    "platform": "linux",
    "lifecycle": "per_acceptance",
    "image_setting": "OMNI_CODE_X11BOX_IMAGE",
    "source_setting": "OMNI_CODE_X11BOX_SOURCE"
  }
}
